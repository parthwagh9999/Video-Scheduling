# ============================================================================
# VIDEO SCHEDULING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize as needed.
# All paths are automatically resolved relative to the project root if omitted.
# ============================================================================

# Application Root (Optional: defaults to repository root directory)
# VIDEO_SCHED_ROOT=H:\google antigravity\Video Scheduling

# Media & Storage Directories
# START_VIDEO_DIR=start video
# END_VIDEO_DIR=End Video
# EXCEL_PATH=output/video_metadata.xlsx
# PROCESSED_VIDEO_DIR=output/processed_videos
# THUMBNAIL_DIR=output/thumbnails
# BROWSER_PROFILE_DIR=browser_profile
# DB_PATH=output/video_scheduler.db

# FFmpeg Executable Paths (Optional: auto-detected from system PATH if omitted)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Dashboard Server Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Scheduling & Timezone Preferences
SCHEDULER_TIMEZONE=Asia/Kolkata
DAILY_UPLOAD_CAP=9
DAILY_PUBLICATION_COUNT=3
PUBLISHING_SLOTS=08:30,18:00,21:00
